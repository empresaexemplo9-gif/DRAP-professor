# Banco (runtime): papel sem BYPASSRLS. Em produção, use o pooler do Supabase (porta 6543) com ?pgbouncer=true
DATABASE_URL="postgresql://drap_app:drap_app@localhost:5432/drap"
# Banco (migrações): papel dono das tabelas, conexão direta (porta 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/drap"

# Autenticação (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET="troque-por-um-segredo-longo"
# Deve ser a URL exata em que o app está sendo acessado (origem confiável para POSTs autenticados)
BETTER_AUTH_URL="http://localhost:3000"

# Chave para cifrar CPF em repouso (32 bytes em base64: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=""

# Tenant padrão quando o domínio não corresponde a nenhum cadastrado
DEFAULT_TENANT_SLUG="drap"

# Opcional: login com Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcional: envio de e-mails (Resend). Sem chave, os e-mails são registrados no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="DRAP Professor <nao-responda@exemplo.com.br>"

# Pagamentos Pix (Asaas). Use credenciais de sandbox em homologação e segredos separados em produção.
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Limite de sessões simultâneas por usuário
MAX_SESSIONS_PER_USER="3"

# Seed
SEED_ADMIN_EMAIL="admin@exemplo.com.br"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_USERS="1"
AUTH_RATE_LIMIT="on"
