// Modelo de dados — Fase 1 (ver docs/ARQUITETURA.md, seção 7).
// Tabelas com "tenantId" são protegidas por Row-Level Security (migração 0002_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Tenant ─────────────────────────────

model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String       @unique
  domains   String[]     @default([])
  legalName String?
  cnpj      String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  theme           ThemeSettings?
  memberships     Membership[]
  levels          Level[]
  segments        Segment[]
  modules         Module[]
  topics          Topic[]
  pixCheckouts    PixCheckout[]
  organizations   Organization[]
  enterpriseLeads EnterpriseLead[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model ThemeSettings {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @unique @db.Uuid
  defaultMode ThemeMode @default(DARK)
  // Sobrescritas de tokens validadas (ver src/theme/tokens.ts): { dark: {...}, light: {...}, fonts: {...} }
  overrides   Json      @default("{}")
  logoUrl     String?
  updatedAt   DateTime  @updatedAt
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("theme_settings")
}

enum ThemeMode {
  DARK
  LIGHT
  SYSTEM
}

// ───────────────────────── Autenticação (Better Auth) ─────────────────────────

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean? @default(false)
  // CPF cifrado (AES-256-GCM) e hash para busca; preenchido só quando necessário (certificado/nota fiscal)
  cpfEncrypted     String?
  cpfHash          String?  @unique
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  memberships        Membership[]
  consents           Consent[]
  enrollments        Enrollment[]
  pixCheckouts       PixCheckout[]
  orgMemberships     OrganizationMember[]
  licenseAssignments LicenseAssignment[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ───────────────────────────── Perfis ─────────────────────────────

enum Role {
  ADMIN
  PEDAGOGICO
  INSTRUTOR
  ALUNO
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String
  roles     Role[]
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  email      String
  roles      Role[]
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, email])
  @@map("invitations")
}

model Consent {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @db.Uuid
  userId          String
  type            ConsentType
  documentVersion String
  acceptedAt      DateTime    @default(now())
  ip              String?
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("consents")
}

enum ConsentType {
  TERMOS
  PRIVACIDADE
  MARKETING
}

// ───────────────────── Hierarquia: Nível › Segmento › Módulo › Assunto ─────────────────────

enum LevelKind {
  MENTORIA
  TREINAMENTO
  CURSO
  AULA
  CAPACITACAO
}

enum ContentStatus {
  RASCUNHO
  REVISAO
  PUBLICADO
  ARQUIVADO
}

enum CertificateType {
  LIVRE
  EXTENSAO
  CAPACITACAO
}

model Level {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  kind        LevelKind
  label       String
  slug        String
  description String?
  order       Int
  active      Boolean   @default(true)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules Module[]

  @@unique([tenantId, kind])
  @@unique([tenantId, slug])
  @@map("levels")
}

model Segment {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  slug        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules Module[]

  @@unique([tenantId, slug])
  @@map("segments")
}

model Module {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  levelId         String          @db.Uuid
  segmentId       String          @db.Uuid
  title           String
  slug            String
  summary         String?
  coverUrl        String?
  workloadMinutes Int             @default(0)
  priceCents      Int?
  // INDIVIDUAL: capacitação vendida por pessoa (Pix). EMPRESA: treinamento vendido por contrato (Enterprise).
  audience        ModuleAudience  @default(INDIVIDUAL)
  status          ContentStatus   @default(RASCUNHO)
  certificateType CertificateType @default(LIVRE)
  // Configuração específica do nível (validada por src/lib/levels.ts)
  levelConfig     Json            @default("{}")
  // Ficha do curso (código, instrutor, revisor, objetivos, bibliografia, versão…) — padrão do arquivo 01
  courseSheet     Json            @default("{}")
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level        Level         @relation(fields: [levelId], references: [id])
  segment      Segment       @relation(fields: [segmentId], references: [id])
  topics       Topic[]
  staff        ModuleStaff[]
  enrollments  Enrollment[]
  pixCheckouts PixCheckout[]
  licensePools LicensePool[]

  @@unique([levelId, segmentId, slug])
  @@index([tenantId, status])
  @@index([tenantId, audience, status])
  @@map("modules")
}

enum ModuleAudience {
  INDIVIDUAL
  EMPRESA
}

enum StaffRole {
  AUTOR
  INSTRUTOR
  MENTOR
}

model ModuleStaff {
  id       String    @id @default(uuid(7)) @db.Uuid
  tenantId String    @db.Uuid
  moduleId String    @db.Uuid
  userId   String
  role     StaffRole

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId, role])
  @@map("module_staff")
}

model Topic {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @db.Uuid
  moduleId           String        @db.Uuid
  title              String
  slug               String
  order              Int           @default(0)
  durationMinutes    Int           @default(0)
  status             ContentStatus @default(RASCUNHO)
  // Rascunho editável do documento em blocos (src/content-blocks/schema.ts)
  draft              Json          @default("{}")
  publishedVersionId String?       @unique @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module           Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  versions         TopicVersion[]  @relation("TopicVersions")
  publishedVersion TopicVersion?   @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  progress         TopicProgress[]
  notebooks        StudyNotebook[]
  questions        Question[]
  attempts         QuizAttempt[]
  feedback         TopicFeedback[]

  @@unique([moduleId, slug])
  @@map("topics")
}

model TopicVersion {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  topicId    String   @db.Uuid
  number     Int
  document   Json
  authorId   String
  changeNote String?
  createdAt  DateTime @default(now())

  topic       Topic  @relation("TopicVersions", fields: [topicId], references: [id], onDelete: Cascade)
  publishedIn Topic? @relation("PublishedVersion")

  @@unique([topicId, number])
  @@map("topic_versions")
}

model SlugRedirect {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  fromPath  String
  toPath    String
  createdAt DateTime @default(now())

  @@unique([tenantId, fromPath])
  @@map("slug_redirects")
}

// ───────────────────────────── Matrículas e progresso ─────────────────────────────

enum EnrollmentOrigin {
  COMPRA
  ASSINATURA
  ATRIBUICAO
  CORTESIA
  LICENCA
}

enum EnrollmentStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
  EXPIRADA
}

model Enrollment {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String
  moduleId  String           @db.Uuid
  origin    EnrollmentOrigin @default(ATRIBUICAO)
  status    EnrollmentStatus @default(ATIVA)
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  // Observação interna registrada pela equipe (painel Matrículas)
  note      String?
  createdAt DateTime         @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  TopicProgress[]
  notebooks StudyNotebook[]
  attempts  QuizAttempt[]
  feedback  TopicFeedback[]

  @@unique([userId, moduleId])
  @@map("enrollments")
}

enum PixCheckoutStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELED
}

model PixCheckout {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @db.Uuid
  userId              String
  moduleId            String            @db.Uuid
  providerPaymentId   String?           @unique
  amountCents         Int
  status              PixCheckoutStatus @default(PENDING)
  pixPayload          String?
  pixImageDataUrl     String?
  expiresAt           DateTime?
  paidAt              DateTime?
  // Observação interna e autor da baixa manual (painel Financeiro)
  adminNote           String?
  manualConfirmedById String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, moduleId, status])
  @@map("pix_checkouts")
}

enum ProgressStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
}

model TopicProgress {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  enrollmentId      String         @db.Uuid
  topicId           String         @db.Uuid
  status            ProgressStatus @default(EM_ANDAMENTO)
  percent           Int            @default(0)
  lastSectionId     String?
  // Aulas (seções) concluídas — base da presença mínima para liberar a prova
  completedSections String[]       @default([])
  quizCycle         Int            @default(1)
  quizPassed        Boolean        @default(false)
  firstScore        Float?
  bestScore         Float?
  completedAt       DateTime?
  updatedAt         DateTime       @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, topicId])
  @@map("topic_progress")
}

// ───────────────────────────── Auditoria e documentos legais ─────────────────────────────

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Respostas de estudo: rascunhos pessoais, sem nota ou aprovação automática.
model StudyNotebook {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  enrollmentId String   @db.Uuid
  topicId      String   @db.Uuid
  answers      Json     @default("{}")
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, topicId])
  @@index([tenantId])
  @@map("study_notebooks")
}

// ───────────────────────────── Avaliações (padrão do arquivo 01) ─────────────────────────────

enum QuestionKind {
  MULTIPLA
  VF
  ASSOCIACAO
}

enum BloomLevel {
  LEMBRAR
  COMPREENDER
  APLICAR
  ANALISAR
}

model Question {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  topicId    String       @db.Uuid
  code       String
  objective  String
  bloom      BloomLevel
  kind       QuestionKind @default(MULTIPLA)
  isCase     Boolean      @default(false)
  stem       String
  // [{ key: "A", text: "..." }, …]
  options    Json
  correct    String
  commentary String
  version    Int          @default(1)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([topicId])
  @@map("questions")
}

enum AttemptStatus {
  EM_ANDAMENTO
  ENTREGUE
  EXPIRADA
}

model QuizAttempt {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  enrollmentId String        @db.Uuid
  topicId      String        @db.Uuid
  cycle        Int
  number       Int
  // Snapshot imutável das questões sorteadas (enunciado, alternativas na ordem exibida, gabarito, comentário, versão)
  items        Json
  answers      Json          @default("{}")
  score        Float?
  passed       Boolean?
  status       AttemptStatus @default(EM_ANDAMENTO)
  startedAt    DateTime      @default(now())
  deadlineAt   DateTime
  submittedAt  DateTime?
  ip           String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, topicId])
  @@index([topicId, status])
  @@map("quiz_attempts")
}

/// Avaliação de reação do aluno (Kirkpatrick nível 1), por módulo.
model TopicFeedback {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @db.Uuid
  enrollmentId  String   @db.Uuid
  topicId       String   @db.Uuid
  clarity       Int
  applicability Int
  overall       Int
  comment       String?
  createdAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, topicId])
  @@map("topic_feedback")
}

// ───────────────────────────── Enterprise (B2B) ─────────────────────────────
// Empresa cliente compra vagas de um curso (LicensePool); o gestor distribui as vagas à equipe.

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrgMemberRole {
  GESTOR
  COLABORADOR
}

enum LicensePoolStatus {
  ACTIVE
  CANCELED
}

enum LicenseAssignmentStatus {
  CONVIDADO
  ATIVO
  REVOGADO
}

enum EnterpriseLeadStatus {
  NOVO
  EM_CONTATO
  FECHADO
  DESCARTADO
}

model Organization {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  name         String
  legalName    String?
  // Somente dígitos
  cnpj         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  pools   LicensePool[]

  @@unique([tenantId, cnpj])
  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @db.Uuid
  organizationId String        @db.Uuid
  userId         String
  role           OrgMemberRole @default(COLABORADOR)
  // Equipe/área dentro da empresa (ex.: "Vendas", "Filial SP")
  team           String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([tenantId, userId])
  @@map("organization_members")
}

model LicensePool {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @db.Uuid
  organizationId String            @db.Uuid
  moduleId       String            @db.Uuid
  seats          Int
  startsAt       DateTime          @default(now())
  // Fim do acesso das vagas; vazio = sem prazo
  endsAt         DateTime?
  // Prazo de conclusão e meta (% da equipe concluída) acompanhados pelo gestor
  dueAt          DateTime?
  goalPercent    Int               @default(90)
  contractCents  Int?
  status         LicensePoolStatus @default(ACTIVE)
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments  LicenseAssignment[]

  @@index([tenantId, organizationId])
  @@map("license_pools")
}

model LicenseAssignment {
  id           String                  @id @default(uuid(7)) @db.Uuid
  tenantId     String                  @db.Uuid
  poolId       String                  @db.Uuid
  email        String
  userId       String?
  // Equipe informada pelo gestor; aplicada ao colaborador quando a vaga é ativada
  team         String?
  status       LicenseAssignmentStatus @default(CONVIDADO)
  assignedById String?
  activatedAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime                @default(now())

  pool LicensePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([poolId, email])
  @@index([tenantId, email, status])
  @@map("license_assignments")
}

model EnterpriseLead {
  id          String               @id @default(uuid(7)) @db.Uuid
  tenantId    String               @db.Uuid
  company     String
  contactName String
  email       String
  phone       String?
  teamSize    Int?
  interests   String[]             @default([])
  message     String?
  status      EnterpriseLeadStatus @default(NOVO)
  createdAt   DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("enterprise_leads")
}

// ───────────────────────────── Preparatório CPA (docs/cpa/PLANO.md) ─────────────────────────────

enum CpaStatus {
  PENDENTE
  EM_ELABORACAO
  REVISADO
  PUBLICADO
  ARQUIVADO
}

enum CpaOrigin {
  IMPORTADO
  EDITADO
}

/// Matriz oficial do Programa Detalhado (redação e numeração originais).
model CpaSyllabusItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  programVersion String
  code           String
  text           String
  level          Int
  macro          Int
  parentCode     String?
  leaf           Boolean
  weight         Int?
  reviewer       String?
  checkedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lessons   CpaLessonItem[]
  questions CpaQuestionItem[]

  @@unique([tenantId, programVersion, code])
  @@index([tenantId, macro])
  @@map("cpa_syllabus_items")
}

model CpaChapter {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  number      Int
  macro       Int
  title       String
  officialRef String
  summary     String?
  order       Int
  status      CpaStatus @default(PUBLICADO)
  origin      CpaOrigin @default(IMPORTADO)
  sourceHash  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lessons CpaLesson[]

  @@unique([tenantId, number])
  @@map("cpa_chapters")
}

model CpaLesson {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  chapterId      String    @db.Uuid
  code           String
  slug           String
  title          String
  order          Int
  minutes        Int
  prerequisites  String[]  @default([])
  objectives     String[]  @default([])
  /// Documento de blocos (src/content-blocks) com o conteúdo integral da aula.
  document       Json
  /// Exercícios de fixação e checklist de domínio (JSON).
  extras         Json      @default("{}")
  references     Json      @default("[]")
  checkedAt      DateTime?
  nextLessonCode String?
  status         CpaStatus @default(EM_ELABORACAO)
  origin         CpaOrigin @default(IMPORTADO)
  sourceHash     String?
  version        Int       @default(1)
  reviewer       String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  chapter  CpaChapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  items    CpaLessonItem[]
  versions CpaLessonVersion[]
  progress CpaLessonProgress[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([chapterId, order])
  @@map("cpa_lessons")
}

model CpaLessonItem {
  lessonId String @db.Uuid
  itemId   String @db.Uuid
  tenantId String @db.Uuid

  lesson CpaLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  item   CpaSyllabusItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([lessonId, itemId])
  @@index([itemId])
  @@map("cpa_lesson_items")
}

/// Histórico de publicação: toda versão publicada registra autor, data e conteúdo.
model CpaLessonVersion {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  lessonId  String   @db.Uuid
  version   Int
  title     String
  document  Json
  authorId  String?
  note      String?
  createdAt DateTime @default(now())

  lesson CpaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version])
  @@map("cpa_lesson_versions")
}

model CpaReference {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  key         String
  title       String
  publisher   String
  url         String?
  scope       String?
  /// Vigência da norma/fonte, quando aplicável.
  validFrom   DateTime?
  checkedAt   DateTime?
  checkStatus String    @default("PENDENTE")
  notes       String?
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, key])
  @@map("cpa_references")
}

enum CpaQuestionType {
  CONCEITO
  CALCULO
  INTERPRETACAO
  COMPARACAO
  CASO
  DECISAO
  DIALOGO
}

enum CpaQuestionUse {
  FIXACAO
  SIMULADO
  DIAGNOSTICO
}

model CpaQuestion {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @db.Uuid
  code        String
  type        CpaQuestionType
  use         CpaQuestionUse
  macro       Int
  stem        String
  /// [{ key, text, justification }]
  options     Json
  correct     String
  explanation String
  difficulty  Int
  competence  String
  source      String
  /// Sempre AUTORAL nesta plataforma (nunca questão de prova aplicada).
  nature      String          @default("AUTORAL")
  lessonCode  String?
  /// Verificação independente de cálculo: expressão e resultado esperado.
  check       Json?
  reviewedAt  DateTime?
  status      CpaStatus       @default(EM_ELABORACAO)
  origin      CpaOrigin       @default(IMPORTADO)
  sourceHash  String?
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items CpaQuestionItem[]

  @@unique([tenantId, code])
  @@index([tenantId, use, macro])
  @@map("cpa_questions")
}

model CpaQuestionItem {
  questionId String @db.Uuid
  itemId     String @db.Uuid
  tenantId   String @db.Uuid

  question CpaQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  item     CpaSyllabusItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([questionId, itemId])
  @@index([itemId])
  @@map("cpa_question_items")
}

enum CpaExamKind {
  DIAGNOSTICO
  MODULO
  INTERMEDIARIO
  COMPLETO
  FINAL
  ATENDIMENTO
}

model CpaExam {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @db.Uuid
  code                 String
  kind                 CpaExamKind
  title                String
  description          String?
  questionCount        Int
  durationMinutes      Int
  /// { "1": 20, "2": 40, "3": 30, "4": 10 } em %; vazio = proporção oficial.
  distribution         Json           @default("{}")
  /// Macrotemas sorteados (simulado por módulo/intermediário).
  macros               Int[]          @default([])
  /// Lista fixa de códigos de questão (simulados completos); vazio = sorteio.
  fixedCodes           String[]       @default([])
  pool                 CpaQuestionUse @default(SIMULADO)
  allowStudyMode       Boolean        @default(true)
  allowBackNav         Boolean        @default(true)
  oneQuestionPerScreen Boolean        @default(true)
  /// Meta pedagógica interna (não é critério oficial de aprovação).
  targetPercent        Int            @default(70)
  order                Int
  status               CpaStatus      @default(PUBLICADO)
  origin               CpaOrigin      @default(IMPORTADO)
  sourceHash           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  attempts CpaAttempt[]

  @@unique([tenantId, code])
  @@map("cpa_exams")
}

enum CpaAttemptMode {
  PROVA
  ESTUDO
}

model CpaAttempt {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  userId      String
  examId      String         @db.Uuid
  mode        CpaAttemptMode
  /// Retrato das questões (enunciado, alternativas embaralhadas, gabarito, explicações, microtemas).
  items       Json
  answers     Json           @default("{}")
  flagged     String[]       @default([])
  /// Segundos gastos por questão { questionId: s }.
  timings     Json           @default("{}")
  startedAt   DateTime       @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  expired     Boolean        @default(false)
  score       Float?
  hits        Int?
  result      Json?

  exam CpaExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, startedAt])
  @@index([examId])
  @@map("cpa_attempts")
}

model CpaTree {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @db.Uuid
  code       String
  title      String
  scenario   String
  /// { start, nodes: { id: { text, choices: [{ label, next, score, feedback, competence }] , end?, outcome? } } }
  graph      Json
  itemCodes  String[]  @default([])
  status     CpaStatus @default(PUBLICADO)
  origin     CpaOrigin @default(IMPORTADO)
  sourceHash String?
  updatedAt  DateTime  @updatedAt

  runs CpaTreeRun[]

  @@unique([tenantId, code])
  @@map("cpa_trees")
}

model CpaTreeRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String
  treeId      String    @db.Uuid
  path        Json      @default("[]")
  score       Int       @default(0)
  maxScore    Int       @default(0)
  competences String[]  @default([])
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  tree CpaTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("cpa_tree_runs")
}

model CpaCard {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  code        String
  front       String
  back        String
  explanation String
  itemCode    String
  lessonCode  String?
  status      CpaStatus @default(PUBLICADO)
  origin      CpaOrigin @default(IMPORTADO)
  sourceHash  String?
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, code])
  @@map("cpa_cards")
}

/// Fila de revisão espaçada por aluno (cartões e questões erradas).
model CpaReview {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String
  kind       String
  refCode    String
  itemCode   String?
  stage      Int      @default(0)
  dueAt      DateTime
  lapses     Int      @default(0)
  lastResult Boolean?
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId, kind, refCode])
  @@index([tenantId, userId, dueAt])
  @@map("cpa_reviews")
}

model CpaLessonProgress {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String
  lessonId    String    @db.Uuid
  completed   Boolean   @default(false)
  seconds     Int       @default(0)
  lastSection String?
  checklist   String[]  @default([])
  exercises   Json      @default("{}")
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  lesson CpaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([tenantId, userId])
  @@map("cpa_lesson_progress")
}

enum CpaAnnotationKind {
  MARCADOR
  DESTAQUE
  NOTA
  FAVORITO
}

model CpaAnnotation {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @db.Uuid
  userId     String
  lessonCode String
  kind       CpaAnnotationKind
  anchor     String?
  quote      String?
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tenantId, userId, lessonCode])
  @@map("cpa_annotations")
}

model CpaStudyPlan {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  userId         String
  examDate       DateTime?
  hoursPerWeek   Int       @default(6)
  pace           String    @default("REGULAR")
  /// Intervalos de revisão em dias (padrão 1, 3, 7, 14).
  reviewDays     Int[]     @default([1, 3, 7, 14])
  studyDays      Int[]     @default([1, 2, 3, 4, 5])
  streakDays     Int       @default(0)
  lastStudyOn    DateTime? @db.Date
  totalSeconds   Int       @default(0)
  lastLessonCode String?
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@map("cpa_study_plans")
}
