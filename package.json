{
  "name": "drap-professor",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de capacitação (EAD/LMS) white-label e multi-segmento.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "cursos:validar": "tsx scripts/validar-cursos.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/lora": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "better-auth": "1.3.34",
    "clsx": "2.1.1",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "playwright-core": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "@eslint/eslintrc": "3.3.7",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
